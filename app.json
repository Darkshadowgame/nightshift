{
  "expo": {
    "name": "Nightshift",
    "slug": "nightshift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.nightshift.ios",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Nightshift uses your location to show events and builds near you and to check you in at meets and cruise stops.",
        "NSPhotoLibraryUsageDescription": "Nightshift uses your photos so you can add pictures of your build.",
        "NSCameraUsageDescription": "Nightshift uses the camera so you can photograph your build.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0f17",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.nightshift.ios",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nightshift uses your location to show events and builds near you and to check you in at meets and cruise stops."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nightshift uses your photos so you can add pictures of your build.",
          "cameraPermission": "Nightshift uses the camera so you can photograph your build."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0b0f17"
        }
      ]
    ],
    "scheme": "nightshift",
    "backgroundColor": "#0b0f17",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "953039ee-ac12-4fab-a0f5-475f0a7b5904"
      }
    },
    "owner": "darkshadowgame",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/953039ee-ac12-4fab-a0f5-475f0a7b5904",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}